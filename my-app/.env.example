VITE_BUTTERBASE_APP_ID=
# Use API *host* only, e.g. https://api.butterbase.ai — NOT https://…/v1/your_app_id
VITE_BUTTERBASE_URL=
VITE_BUTTERBASE_ANON_KEY=

# Optional alias:
# VITE_BUTTERBASE_API_URL=https://api.butterbase.ai
